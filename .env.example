# Copy to .env and fill in. Never commit .env.
SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost
SITE_URL=http://127.0.0.1:8000

# Email (Gmail: use an App Password)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=Delight Care Plus <no-reply@delightcareplus.com>
ADMIN_EMAILS=you@example.com

# Shop (most shop settings — free delivery, pay on delivery, Airtel number — are in Seller Center → Shop settings)
WHATSAPP_NUMBER=254795180079
INSTAGRAM_URL=https://www.instagram.com/

# M-Pesa (Daraja)
MPESA_ENVIRONMENT=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=174379
MPESA_PASSKEY=
MPESA_TRANSACTION_TYPE=CustomerPayBillOnline
MPESA_CALLBACK_URL=https://your-domain.com/orders/mpesa/callback/
# Long random secret added to the callback URL so fake payment calls are rejected
MPESA_CALLBACK_TOKEN=change-me-to-a-long-random-string

# Airtel Money number customers send to (manual confirmation)
AIRTEL_MONEY_NUMBER=
